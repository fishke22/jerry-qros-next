{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jerry-qros-next.local/schemas/data-source-registry/v1",
  "title": "Jerry QROS Next Data Source Registry v1",
  "type": "object",
  "required": [
    "registry_version",
    "policy",
    "constraints",
    "sources"
  ],
  "properties": {
    "registry_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "provider",
          "dataset",
          "endpoint",
          "official_status",
          "cost_class",
          "access_class",
          "data_role",
          "historical_depth",
          "frequency",
          "latency",
          "storage_rights",
          "redistribution_rights",
          "terms_url",
          "terms_verified_at",
          "provenance_required",
          "validation_grade",
          "fallback_source",
          "status"
        ]
      }
    }
  },
  "additionalProperties": true
}
