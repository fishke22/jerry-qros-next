{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jerry-qros-next.local/contracts/validation-result/v1",
  "title": "QROS Validation Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "subject_id",
    "classification",
    "blocking_reasons",
    "gate_opened",
    "research_only"
  ],
  "properties": {
    "contract_id": {
      "const": "validation-result"
    },
    "contract_version": {
      "const": "1"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "enum": [
        "PASS_REVIEW_ONLY",
        "FAIL_REQUIRES_REPAIR",
        "BLOCKED_INSUFFICIENT_EVIDENCE",
        "UNKNOWN"
      ]
    },
    "blocking_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gate_opened": {
      "const": false
    },
    "research_only": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {
            "const": "PASS_REVIEW_ONLY"
          }
        }
      },
      "then": {
        "properties": {
          "blocking_reasons": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "enum": [
              "FAIL_REQUIRES_REPAIR",
              "BLOCKED_INSUFFICIENT_EVIDENCE",
              "UNKNOWN"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "blocking_reasons": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
