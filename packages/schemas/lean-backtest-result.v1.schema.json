{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jerry-qros-next.local/contracts/lean-backtest-result/v1",
  "title": "QROS LEAN Backtest Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "engine",
    "engine_revision",
    "algorithm_id",
    "algorithm_assembly_hash",
    "input_hash",
    "config_hash",
    "classification",
    "research_only",
    "gate_opened",
    "statistics",
    "normalized_hash"
  ],
  "properties": {
    "contract_id": {"const": "lean-backtest-result"},
    "contract_version": {"const": "1"},
    "engine": {"const": "QuantConnect/Lean"},
    "engine_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "algorithm_id": {"type": "string", "minLength": 1},
    "algorithm_assembly_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "config_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "classification": {"const": "PASS_REVIEW_ONLY"},
    "research_only": {"const": true},
    "gate_opened": {"const": false},
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qros_rows", "qros_sum", "qros_last", "total_orders"],
      "properties": {
        "qros_rows": {"const": "5"},
        "qros_sum": {"const": "510.0000"},
        "qros_last": {"const": "104.0000"},
        "total_orders": {"const": "0"}
      }
    },
    "normalized_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
